{
  "name": "pathshala",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --d1 DB=pathshala-db --port 8788",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "npm run build && wrangler pages dev dist --d1 DB=pathshala-db",
    "deploy": "npm run build && wrangler pages deploy dist --project-name pathshala",
    "db:create": "wrangler d1 create pathshala-db",
    "db:init": "wrangler d1 execute pathshala-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute pathshala-db --local --file=./schema.sql",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
