# GEMINI_API_KEY: Optional. When present, AI endpoints call Gemini; otherwise
# the app serves rich Bengali fallback content (everything still works).
# Set it on Cloudflare with:
#   npx wrangler pages secret put GEMINI_API_KEY --project-name pathshala
GEMINI_API_KEY=""

# Gemini model used by the API (defaults to gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# Comma separated emails that always register as super admin.
SUPERADMIN_EMAILS="creativeteamoperation@gmail.com"

# Public site URL (used in SEO files).
APP_URL="https://pathshala.pages.dev"
